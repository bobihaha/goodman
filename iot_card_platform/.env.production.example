APP_NAME=IoT_Card_Platform
APP_ENV=production
DEBUG=False
PORT=8000

# Single ECS production defaults for 8C16G
DB_HOST=mysql
DB_PORT=3306
DB_USER=iot_app
DB_PASSWORD=change_me_app_password
DB_NAME=iot_card_platform
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=iot_card_platform
MYSQL_USER=iot_app
MYSQL_PASSWORD=change_me_app_password

SECRET_KEY=replace_with_a_random_64_char_secret
ENCRYPTION_KEY=replace_with_a_fernet_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPER_LOGIN_EXPIRE_MINUTES=60

# Single ECS production defaults for 8C16G
REDIS_URL=redis://redis:6379/0

# Runtime sizing
# Keep backend single-process for now because APScheduler starts inside app lifespan.
BACKEND_WORKERS=1
MYSQL_MAX_CONNECTIONS=300
MYSQL_INNODB_BUFFER_POOL_SIZE=4G
MYSQL_INNODB_LOG_FILE_SIZE=512M
MYSQL_TMP_TABLE_SIZE=64M
MYSQL_MAX_HEAP_TABLE_SIZE=64M
REDIS_MAXMEMORY=768mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# SMTP 邮件配置
SMTP_ENABLED=False
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=help@shldyxxkjyxgs.wecom.work
SMTP_PASSWORD=replace_with_smtp_authorization_code
SMTP_FROM_EMAIL=help@shldyxxkjyxgs.wecom.work
SMTP_FROM_NAME=IoT Card Platform
SMTP_USE_TLS=False
SMTP_USE_SSL=True
SMTP_TIMEOUT=30

# Replace with your actual domains. JSON array format is required by Pydantic.
ALLOW_ORIGINS=["https://iot.example.com","https://admin.example.com"]

MAX_BATCH_OPERATION_SIZE=10000
MAX_EXPORT_SIZE=10000

# Supplier 002: SIMBOSS
SIMBOSS_API_URL=https://api.simboss.com
SIMBOSS_APPID=replace_with_simboss_appid
SIMBOSS_APP_SECRET=replace_with_simboss_app_secret
SIMBOSS_TEST_ICCID=replace_with_simboss_test_iccid

# 应用配置
APP_NAME=IoT_Card_Platform_Dev
APP_ENV=development
DEBUG=True
PORT=8000

# 数据库配置
DB_URL=mysql+aiomysql://root:root123456@localhost:3306/iot_card_db?charset=utf8mb4

# JWT 配置
